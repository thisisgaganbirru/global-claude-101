# Deny-by-default allowlist.
# This repo tracks only the curated global-config files below.
# Everything else in ~/.claude/ (credentials, session history, caches,
# plugin caches, downloaded skill packages, etc.) stays untracked, even
# if new files/folders are added here later.
*

!.gitignore
!CLAUDE.md
!README.md
!AGENT-DISPATCH.md
!hooks.json
!keybindings.json
!settings.json
!skills-lock.json
!statusline-command.sh
!statusline-debug.sh

!rules/
!rules/**

!hooks/
!hooks/**

!agents/
!agents/**

!docs/
!docs/**

!skills/
!skills/**

# hallmark is a third-party skill package (also installed as a plugin,
# reinstalls itself from settings.json's enabledPlugins) - not yours to
# version-control, and it's 26MB+ of redistributed content.
skills/hallmark/

# llm-council is a clone of an external repo (has its own .git/remote) -
# see README.md "External skills" for the clone command.
skills/llm-council/

# use-railway is Railway's own vendor skill, bundled with the railway MCP
# integration - see README.md "External skills" for reinstall instructions.
skills/use-railway/

# Python build artifacts - never belong in source control.
__pycache__/
*.pyc
